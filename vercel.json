{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:page", "destination": "/:page.html" },
    { "source": "/:section/:page", "destination": "/:section/:page.html" },
    { "source": "/:section/:group/:page", "destination": "/:section/:group/:page.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
