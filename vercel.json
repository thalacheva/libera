{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "libera-nine.vercel.app" }],
      "destination": "https://www.libera-edu.bg/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!google0c26b651ebed416f\\.html$).+)",
      "has": [{ "type": "host", "value": "libera-nine.vercel.app" }],
      "destination": "https://www.libera-edu.bg/:path",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/:page", "destination": "/:page.html" },
    { "source": "/:section/:page", "destination": "/:section/:page.html" },
    { "source": "/:section/:group/:page", "destination": "/:section/:group/:page.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
